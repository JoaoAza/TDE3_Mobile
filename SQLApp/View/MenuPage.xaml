<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLApp.View.MenuPage" Title="Menu principal">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="SQLApp - Controle de compras" FontSize="24" FontAttributes="Bold" />
        <Label Text="Selecione uma opção:" />
        <Button Text="Cadastro de Clientes" Clicked="btClientes_Clicked" />
        <Button Text="Cadastro de Produtos" Clicked="btProdutos_Clicked" />
        <Button Text="Compra" Clicked="btCompras_Clicked" />
    </VerticalStackLayout>
</ContentPage>
