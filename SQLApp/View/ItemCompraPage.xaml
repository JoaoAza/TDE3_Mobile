<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLApp.View.ItemCompraPage" Title="Itens da compra">
    <Grid Padding="10" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Label Text="Itens da compra" FontSize="22" FontAttributes="Bold" />
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="10">
            <Label Text="Código (gerado na inclusão):" />
            <Entry x:Name="txID" Placeholder="Código para consultar, alterar ou excluir" Keyboard="Numeric" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Consultar" Clicked="btConsultar_Clicked" />
                <Button Grid.Column="1" Text="Limpar Form" Clicked="btLimpar_Clicked" />
            </Grid>
            <Label x:Name="lbCompra" FontAttributes="Bold" />
            <Label Text="Produto:" />
            <Picker x:Name="pkProduto" Title="Selecione o produto" ItemDisplayBinding="{Binding Descricao}" />
            <Label x:Name="lbParcial" Text="Valor parcial: calculado ao salvar" />
            <Label Text="O valor parcial e o estoque são atualizados ao salvar o item." />
            <Label Text="Quantidade:" />
            <Entry x:Name="txQuantidade" Placeholder="Quantidade" Keyboard="Numeric" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button Text="Incluir" Clicked="btIncluir_Clicked" Padding="5" />
                <Button Grid.Column="1" Text="Alterar" Clicked="btAlterar_Clicked" Padding="5" />
                <Button Grid.Column="2" Text="Excluir" Clicked="btExcluir_Clicked" Padding="5" />
            </Grid>
            <Label Text="Registros — toque para preencher o formulário" FontAttributes="Bold" />
            <CollectionView x:Name="lvLista" SelectionMode="Single" HeightRequest="300"
                            SelectionChanged="lvLista_SelectionChanged" EmptyView="Nenhum registro encontrado.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="8" Spacing="3">
                            <Label Text="{Binding CodigoItem, StringFormat='CodigoItem: {0}'}" />
                            <Label Text="{Binding CodigoProduto, StringFormat='CodigoProduto: {0}'}" />
                            <Label Text="{Binding Quantidade, StringFormat='Quantidade: {0}'}" />
                            <Label Text="{Binding ValorParcial, StringFormat='ValorParcial: R$ {0:N2}'}" />
                            <BoxView HeightRequest="1" Color="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="Atualizar lista" Clicked="btAtualizar_Clicked" />
    </Grid>
</ContentPage>
