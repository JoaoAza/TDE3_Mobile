<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SQLApp.View.CompraPage" Title="Compra">
    <Grid Padding="10" RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <Label Text="Compra" FontSize="22" FontAttributes="Bold" />
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="10">
            <Label Text="Código (gerado na inclusão):" />
            <Entry x:Name="txID" Placeholder="Código para consultar, alterar ou excluir" Keyboard="Numeric" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Consultar" Clicked="btConsultar_Clicked" />
                <Button Grid.Column="1" Text="Limpar Form" Clicked="btLimpar_Clicked" />
            </Grid>
            <Label Text="Cliente:" />
            <Picker x:Name="pkCliente" Title="Selecione o cliente" ItemDisplayBinding="{Binding Descricao}" />
            <Label Text="Data da compra:" />
            <DatePicker x:Name="dpDataCompra" Format="dd/MM/yyyy" />
            <Label x:Name="lbTotal" Text="Valor total: R$ 0,00" FontAttributes="Bold" />
            <Label Text="Inclua a compra e depois selecione-a para cadastrar seus itens." />
            <Button Text="Itens da compra selecionada" Clicked="btItens_Clicked" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button Text="Incluir" Clicked="btIncluir_Clicked" Padding="5" />
                <Button Grid.Column="1" Text="Alterar" Clicked="btAlterar_Clicked" Padding="5" />
                <Button Grid.Column="2" Text="Excluir" Clicked="btExcluir_Clicked" Padding="5" />
            </Grid>
            <Label Text="Registros — toque para preencher o formulário" FontAttributes="Bold" />
            <CollectionView x:Name="lvLista" SelectionMode="Single" HeightRequest="300"
                            SelectionChanged="lvLista_SelectionChanged" EmptyView="Nenhum registro encontrado.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="8" Spacing="3">
                            <Label Text="{Binding CodigoCompra, StringFormat='CodigoCompra: {0}'}" />
                            <Label Text="{Binding CodigoCliente, StringFormat='CodigoCliente: {0}'}" />
                            <Label Text="{Binding DataCompra, StringFormat='Data: {0:dd/MM/yyyy}'}" />
                            <Label Text="{Binding ValorTotal, StringFormat='ValorTotal: R$ {0:N2}'}" />
                            <BoxView HeightRequest="1" Color="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="Atualizar lista" Clicked="btAtualizar_Clicked" />
    </Grid>
</ContentPage>
